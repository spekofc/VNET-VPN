{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VNET VPN",
  "version": "0.1.0",
  "identifier": "com.vnet.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VNET VPN",
        "width": 348,
        "height": 560,
        "minWidth": 348,
        "minHeight": 470,
        "resizable": true,
        "decorations": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
